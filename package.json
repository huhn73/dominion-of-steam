{
  "name": "dominion-of-steam",
  "version": "0.10.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter './apps/*' dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "sim": "pnpm --filter @dos/sim sim",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@12.16.1"
}
