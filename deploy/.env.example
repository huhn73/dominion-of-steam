# Produktions-Umgebung für /opt/dominion/.env (Compose und App lesen dieselbe Datei)

# Domain, für die Caddy das Zertifikat holt
DOMAIN=dominion.huhn73.de

# Postgres-Passwort, z. B. `openssl rand -hex 24`
POSTGRES_PASSWORD=

# Image-Tag der App: latest, oder zum Rollback ein sha-Tag aus der GitHub Container Registry
APP_TAG=latest

# Basis-URL für Links in E-Mails
PUBLIC_URL=https://dominion.huhn73.de

# X-Forwarded-* von Caddy vertrauen, damit das Sitzungs-Cookie Secure wird
TRUST_PROXY=true

# E-Mail über Mailjet (Benutzername = API-Key, Passwort = Secret-Key aus den SMTP-Einstellungen,
# Sonderzeichen URL-kodiert). Leer lassen = kein Mailversand.
SMTP_URL=smtps://API-KEY:SECRET-KEY@in-v3.mailjet.com:465
MAIL_FROM=Dominion of Steam <noreply@huhn73.de>
# Kontaktadresse in den Hinweis-Mails („Wenn du das nicht warst …“)
SUPPORT_EMAIL=postmaster@huhn73.de

# Kontakt im Web-Push (VAPID). Die Schlüssel selbst erzeugt der Server und speichert sie in der
# Datenbank; VAPID_PUBLIC_KEY/VAPID_PRIVATE_KEY nur setzen, wenn sie von außen kommen sollen.
VAPID_SUBJECT=mailto:postmaster@huhn73.de

# Nicht setzen: NODE_ENV und STATIC_DIR kommen aus dem Image, DEV_TOOLS bleibt aus.
