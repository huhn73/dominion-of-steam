# Zugang zur Sicherung außer Haus für /opt/dominion/backup.env (nur der offsite-Dienst liest sie).

# Ziel: rclone-Remote (siehe README, „Backups“) und Ordner, z. B. Google Drive
RESTIC_REPOSITORY=rclone:gdrive:dominion-backup

# Schlüssel der Sicherung, z. B. `openssl rand -base64 33`.
# Unbedingt zusätzlich im Passwort-Manager ablegen: ohne ihn ist die Sicherung wertlos.
RESTIC_PASSWORD=
