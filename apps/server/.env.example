DATABASE_URL=postgres://dos:dos@localhost:5442/dos
TEST_DATABASE_URL=postgres://dos:dos@localhost:5442/dos_test
PORT=3000
# E-Mail-Benachrichtigungen (docker compose startet Mailpit: http://localhost:8025)
SMTP_URL=smtp://localhost:1025
# Optional: Kontaktadresse in den Hinweis-Mails (Vorgabe: Absender aus MAIL_FROM)
# SUPPORT_EMAIL=postmaster@huhn73.de
# Optional: Basis-URL für Links in E-Mails (sonst die Adresse der letzten Anfrage)
# PUBLIC_URL=http://localhost:5173
# Optional: VAPID-Schlüssel für Web-Push (sonst einmal erzeugt und in app_config gespeichert)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:noreply@dominion-of-steam.app
# Optional: X-Forwarded-* eines Reverse-Proxys vertrauen (Produktion hinter Caddy, Cookie Secure)
# TRUST_PROXY=true
# Optional: Worker-Threads für KI-Züge (Vorgabe: min(2, Kerne - 1), mindestens 1)
# AI_WORKERS=1
