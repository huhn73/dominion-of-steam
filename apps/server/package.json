{
  "name": "@dos/server",
  "version": "0.11.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "start": "tsx src/index.ts",
    "build": "node build.mjs",
    "start:prod": "node --enable-source-maps dist/index.js",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env src/migrate.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@dos/shared": "workspace:*",
    "@fastify/compress": "^9.3.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/multipart": "^10.1.6",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.8",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "nodemailer": "^10.3.1",
    "postgres": "^3.4.9",
    "sharp": "^0.35.5",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
